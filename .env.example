# ===== Synapse.07 Store — environment configuration =====
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit real keys.

# ---------- Database ----------
# Postgres / Neon. Used by Prisma and by the catalogue read layer (src/lib/store.ts).
# Vercel Postgres exposes POSTGRES_URL; either variable works (POSTGRES_URL wins).
# Example: postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/synapse07?sslmode=require"
# POSTGRES_URL=""

# ---------- Auth / session ----------
# Used to sign the admin session cookie. MUST be >= 32 chars in production.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# Encrypts secrets saved from the admin panel (currently the SMTP password).
# Optional — falls back to AUTH_SECRET if left empty. Set it to a DIFFERENT
# long random value in production so rotating AUTH_SECRET does not orphan the
# secrets already stored in the database.
SETTINGS_ENCRYPTION_KEY=""

# Admin login credentials created by `npm run db:seed`.
# Change the password from the Admin panel after first login.
ADMIN_EMAIL="admin@synapse07.store"
ADMIN_PASSWORD="Admin@12345"

# ---------- Customer accounts: Google sign-in ----------
# OPTIONAL. Powers the "Continue with Google" button on /account.
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials ->
# OAuth client ID (type: Web application). Add this redirect URI:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# (e.g. http://localhost:3000/api/auth/google/callback for local dev).
# With these empty, email signup/signin still works; the Google button shows a
# note that it is not switched on yet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="SYNAPSE.07"
STORE_SUPPORT_EMAIL="kapish.nakum@gmail.com"
STORE_SUPPORT_PHONE="+91 7041169494"

# ---------- Digital delivery ----------
# How long a download link stays valid (hours).
DOWNLOAD_TTL_HOURS="24"
# How many times a single emailed link can be downloaded.
DOWNLOAD_MAX_USES="3"

# ---------- Payment gateway ----------
# Leave all three EMPTY to use the built-in mock gateway (local testing only).
# The storefront picks whichever provider is configured.

# Razorpay  https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe  https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cashfree  https://sandbox.cashfree.com/payments/online
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_API_VERSION="2023-08-01"

# ---------- SMTP (email delivery) ----------
# OPTIONAL. The normal path is Admin > Settings > Email delivery, where the
# password is encrypted before being stored. These variables are only a
# fallback for headless/serverless setups — leave them empty and use the panel.
# With neither set, download links still appear on the order success page.
# Gmail: enable 2FA then create an App Password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="SYNAPSE.07"
SMTP_FROM_EMAIL=""

# ---------- Social proof numbers ----------
# OPTIONAL. The normal path is Admin > Settings > Social proof numbers, where
# these are encrypted before being stored. Env vars are a fallback only.
# With neither set, the manual counts in Admin > Settings > Social links are used,
# and if those are blank the homepage simply omits the tile.
#
# YouTube: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials ->
# API key. Uses the channel URL saved in Admin > Settings > Social links.
YOUTUBE_API_KEY=""
#
# Instagram: requires a Professional (Business/Creator) account linked to a
# Facebook Page. Token is long-lived and expires about every 60 days.
# https://developers.facebook.com/docs/instagram-platform/instagram-api-with-facebook-login/get-started
INSTAGRAM_ACCESS_TOKEN=""

# ---------- File storage (Cloudflare R2) ----------
# R2 is S3-compatible. Dashboard -> R2 -> Manage R2 tokens -> Create bucket + API token.
# If R2_ACCOUNT_ID is empty the app falls back to writing files into ./storage (local dev only).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="synapse07-products"
# Custom domain for public delivery, e.g. https://cdn.yourdomain.com
R2_PUBLIC_URL=""
# OPTIONAL. Enables the monthly Class A/B operations rows on the admin
# dashboard usage card (Cloudflare GraphQL Analytics API). Needs an API token
# with Account / Workers R2 Storage: Read permission.
CLOUDFLARE_API_TOKEN=""